# Port d'écoute de l'API (conteneur). Donné par la plateforme en 8081, ne pas changer en prod.
PORT=8081

# Base de données Postgres de l'application.
DB_HOST=postgres.internal
DB_NAME=team29
DB_USER=postgres
DB_PASSWORD=postgres-dev-password

# Coffre de secrets de la plateforme (OpenBao).
VAULT_ADDR=http://openbao.internal:8200

# File/cache Valkey (compatible Redis).
REDIS_URL=redis://valkey.internal:6379

# Magasin d'objets S3 (bucket créé par l'application au démarrage).
S3_ENDPOINT=http://host.containers.internal:9000

# Build
# Aucune variable lue au moment du build pour l'instant (export Next.js statique, sans NEXT_PUBLIC_*).
